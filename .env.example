# ─── IFFIU Configuration ─────────────────────────────────────────────
# Copy to .env and fill in real values

# App
APP_NAME=IFFIU
DEBUG=false
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32

# Database
DATABASE_URL=postgresql://iffiu:iffiu_secret_change_me@db:5432/iffiu
DB_PASSWORD=iffiu_secret_change_me

# AWS — Same account as KAMPA (754840114791, eu-central-1)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your_aws_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_here

# KAMPA Integration
KAMPA_LAMBDA_FUNCTION=kampa-predict-analyze
KAMPA_S3_BUCKET=kampa-transcoded-output
KAMPA_UPLOAD_BUCKET=kampa-uploads

# Stripe (setup later)
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
